graph LR
    %% Input
    BRIEF["Campaign Brief\n(YAML)"]

    %% 7 Stages
    S1["1. Ingest\n& Validate"]
    S2["2. Analyze\nBrief Quality"]
    S3["3. Resolve\nCached Heroes"]
    S4["4. Generate\nHeroes"]
    S5["5. Compose\nCreatives"]
    S6["6. Validate\nCompliance"]
    S7["7. Report"]

    %% Modules (below stages)
    M1["models.py\nPydantic"]
    M2["analyzer.py\nHeuristic + LLM"]
    M3["storage.py\nCache Check"]
    M4["providers.py\nFirefly / Gemini / Mock"]
    M5["compositor.py\n+ templates.py\nPillow"]
    M6["validator.py\nPixel + Text"]
    M7["report.py\nHTML / JSON"]

    %% Output
    OUTPUT["18 Localized\nCreatives"]

    %% Flow
    BRIEF --> S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7 --> OUTPUT

    %% Module connections
    S1 -.- M1
    S2 -.- M2
    S3 -.- M3
    S4 -.- M4
    S5 -.- M5
    S6 -.- M6
    S7 -.- M7

    %% Styling
    classDef stage fill:#1B4F72,stroke:#1B4F72,color:#fff,font-weight:bold
    classDef module fill:#F5E6CA,stroke:#D4A574,color:#333
    classDef io fill:#D4A574,stroke:#1B4F72,color:#fff,font-weight:bold

    class S1,S2,S3,S4,S5,S6,S7 stage
    class M1,M2,M3,M4,M5,M6,M7 module
    class BRIEF,OUTPUT io
